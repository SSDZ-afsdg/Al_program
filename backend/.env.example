# ==========================================================================
# .env.example —— 环境变量示例文件
# 使用方式：复制本文件为 .env，然后按实际环境修改各项配置
#   cp .env.example .env      (Linux / macOS)
#   copy .env.example .env    (Windows)
# ==========================================================================

# -------- 应用基础配置 --------
APP_NAME=法宝-AI法律助手后端
# 运行环境：development（开发）/ production（生产）
APP_ENV=development
# 调试模式开关
DEBUG=true

# -------- MySQL 数据库配置 --------
# 数据库主机地址
DB_HOST=127.0.0.1
# 数据库端口（MySQL 默认 3306）
DB_PORT=3306
# 数据库用户名
DB_USER=root
# 数据库密码
DB_PASSWORD=123456
# 数据库名称（需提前在 MySQL 中创建：CREATE DATABASE fabao DEFAULT CHARSET utf8mb4;）
DB_NAME=fabao

# -------- JWT 认证配置 --------
# JWT 签名密钥（生产环境务必改为足够复杂的随机字符串，例如：openssl rand -hex 32）
JWT_SECRET_KEY=please-change-this-to-a-random-secret-key-in-production
# JWT 签名算法
JWT_ALGORITHM=HS256
# Token 有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# -------- 文件上传配置 --------
# 合同文件上传存储目录（相对于 backend 根目录）
UPLOAD_DIR=uploads
# 允许上传的文件扩展名
ALLOWED_EXTENSIONS=docx,pdf
# 单个文件大小上限（字节，默认 10MB）
MAX_FILE_SIZE=10485760

# -------- 跨域配置 --------
# 允许的前端来源，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -------- FastGPT AI 服务配置（三套，分别对应三个功能模块） --------
# 每个功能模块使用独立的 FastGPT 应用，可分别配置工作流、知识库与提示词。
# 在 FastGPT 应用详情页获取 API Key，应用 ID 从应用 URL 路径中获取。

# —— AI法律咨询模块 ——
FASTGPT_CHAT_BASE_URL=https://cloud.fastgpt.cn
FASTGPT_CHAT_API_KEY=your-fastgpt-chat-api-key
FASTGPT_CHAT_APP_ID=your-fastgpt-chat-app-id

# —— 文书生成模块 ——
FASTGPT_DOC_BASE_URL=https://cloud.fastgpt.cn
FASTGPT_DOC_API_KEY=your-fastgpt-doc-api-key
FASTGPT_DOC_APP_ID=your-fastgpt-doc-app-id

# —— 合同审查模块 ——
FASTGPT_CONTRACT_BASE_URL=https://cloud.fastgpt.cn
FASTGPT_CONTRACT_API_KEY=your-fastgpt-contract-api-key
FASTGPT_CONTRACT_APP_ID=your-fastgpt-contract-app-id
